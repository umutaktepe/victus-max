[Unit]
Description=Victus Max — Unified Daemon (victus-max-daemon)
After=dbus.service systemd-logind.service
Requires=dbus.service systemd-logind.service

[Service]
Type=simple
ExecStartPre=/bin/sleep 2
ExecStart=/usr/libexec/victus-max/victus-max-daemon
Restart=on-failure
RestartSec=3

# Run as root to access MSRs, WMI, and D-Bus policies
# DynamicUser is removed because D-Bus doesn't play well with dynamically allocated users

# Security sandboxing
NoNewPrivileges=true
LockPersonality=true
RestrictSUIDSGID=true
ProtectSystem=strict
PrivateTmp=true
ProtectHome=true
PrivateNetwork=false
ProtectKernelModules=false
ProtectControlGroups=true
RestrictNamespaces=true

# Allow /sys writes for unprivileged fan/power control via udev rules
# StateDirectory ensures /var/lib/victus-max-daemon/ is created by systemd so
# fan_config.json can be written under ProtectSystem=strict
ProtectKernelTunables=no
StateDirectory=victus-max-daemon
ReadWritePaths=/sys /etc/victus-max /var/lib/victus-max-daemon

[Install]
WantedBy=multi-user.target
